<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Registration - Task 5</title>

    <!-- Bootstrap CSS -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/style.css">

</head>


<body>

    <!-- ============================= -->
    <!-- NAVBAR -->
    <!-- ============================= -->

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

        <div class="container">

            <a class="navbar-brand fw-bold" href="/">
                Student Portal
            </a>

            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav">

                <span class="navbar-toggler-icon"></span>

            </button>


            <div
                class="collapse navbar-collapse"
                id="navbarNav">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a
                            class="nav-link active"
                            href="#home">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a
                            class="nav-link"
                            href="#registration">
                            Registration
                        </a>
                    </li>

                    <li class="nav-item">
                        <a
                            class="nav-link"
                            href="#students">
                            Students
                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>



    <!-- ============================= -->
    <!-- HERO -->
    <!-- ============================= -->

    <section
        id="home"
        class="hero-section">

        <div class="container text-center">

            <h1>
                Welcome to Student Registration
            </h1>

            <p>
                Register students using our REST API.
            </p>

        </div>

    </section>



    <!-- ============================= -->
    <!-- REGISTRATION -->
    <!-- ============================= -->

    <section
        id="registration"
        class="registration-section">

        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-6 col-md-8 col-sm-12">

                    <div class="registration-card">

                        <h2 class="text-center mb-4">
                            Student Registration
                        </h2>


                        <!-- IMPORTANT:
                             No action="/submit"
                             JavaScript will handle submission
                        -->

                        <form id="studentForm">


                            <!-- NAME -->

                            <div class="mb-3">

                                <label class="form-label">
                                    Full Name
                                </label>

                                <input
                                    type="text"
                                    name="name"
                                    class="form-control"
                                    placeholder="Enter your full name"
                                    required>

                            </div>



                            <!-- EMAIL -->

                            <div class="mb-3">

                                <label class="form-label">
                                    Email Address
                                </label>

                                <input
                                    type="email"
                                    name="email"
                                    class="form-control"
                                    placeholder="Enter your email"
                                    required>

                            </div>



                            <!-- PHONE -->

                            <div class="mb-3">

                                <label class="form-label">
                                    Phone Number
                                </label>

                                <input
                                    type="tel"
                                    name="phone"
                                    class="form-control"
                                    placeholder="Enter 10-digit phone number"
                                    required>

                            </div>



                            <!-- COURSE -->

                            <div class="mb-3">

                                <label class="form-label">
                                    Select Course
                                </label>

                                <select
                                    name="course"
                                    class="form-select"
                                    required>

                                    <option value="">
                                        Choose a course
                                    </option>

                                    <option value="Full Stack Development">
                                        Full Stack Development
                                    </option>

                                    <option value="Python">
                                        Python
                                    </option>

                                    <option value="Java">
                                        Java
                                    </option>

                                    <option value="Data Science">
                                        Data Science
                                    </option>

                                </select>

                            </div>



                            <!-- SUBMIT -->

                            <button
                                type="submit"
                                class="btn btn-primary w-100 submit-btn">

                                Register Now

                            </button>


                        </form>


                        <!-- MESSAGE -->

                        <div
                            id="message"
                            class="mt-3 text-center">
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>



    <!-- ============================= -->
    <!-- STUDENT LIST -->
    <!-- ============================= -->

    <section
        id="students"
        class="container pb-5">

        <h2 class="text-center mb-4">
            Registered Students
        </h2>


        <div
            id="studentList"
            class="row">

        </div>

    </section>



    <!-- ============================= -->
    <!-- FOOTER -->
    <!-- ============================= -->

    <footer class="footer">

        <p>
            © 2026 Student Registration System
        </p>

    </footer>



    <!-- Bootstrap JavaScript -->

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


    <!-- Task 5 API JavaScript -->

    <script src="/api.js"></script>


</body>

</html>